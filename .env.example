# =============================================================================
# Espaço Therapy — variáveis de ambiente (copie para `.env`)
# =============================================================================

# URL canônica do site. Usada em canonical/Open Graph/JSON-LD (build) e em
# robots.txt/sitemap.xml (servidor). Sem valor, vale o padrão de
# `shared/site.ts` (DEFAULT_SITE_URL).
SITE_URL=https://espacotherapy.com.br
VITE_SITE_URL=https://espacotherapy.com.br

# Porta do servidor Express (`pnpm start`).
PORT=3000

# Storage remoto das imagens (proxy `/manus-storage` em dev e produção).
# Sem essas variáveis, as imagens precisam estar versionadas em
# `client/public/manus-storage/` (ver docs/seo-and-assets.md).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Analytics (opcional). Quando definido, o script é injetado no HTML pelo
# plugin de SEO do Vite (sem valor, nenhum script é adicionado).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# =============================================================================
# Publicação na Vercel (ver docs/architecture.md §6 e plans/plan-003)
# =============================================================================
# A Vercel publica o SPA (preset Vite, saída `dist/public`) e NÃO executa o
# servidor Express. Definir no projeto da Vercel (Environment Variables, também
# no build):
#
# - SITE_URL=https://espacotherapy.com.br
# - VITE_SITE_URL=https://espacotherapy.com.br
#
# As imagens de `/manus-storage/*` precisam estar versionadas em
# `client/public/manus-storage/` (arquivos estáticos têm precedência) OU as envs
# do storage abaixo precisam existir na Vercel, para que a função
# `api/manus-storage/[...key].ts` gere a URL assinada.
